# Copiez ce fichier en ".env.test" (jamais committé) pour lancer la suite de
# tests. Pointe vers une base Postgres séparée de celle du développement —
# les tests d'intégration la tronquent entre chaque cas.
#
# 1. Créez la base sur le même conteneur Docker que le développement :
#      docker exec iugm_postgres_db createdb -U iugm_admin iugm_scolarite_test_db
# 2. Appliquez les migrations dessus :
#      DATABASE_URL="postgresql://iugm_admin:<mot_de_passe>@localhost:5432/iugm_scolarite_test_db?schema=public" npx prisma migrate deploy

DATABASE_URL="postgresql://iugm_admin:<mot_de_passe>@localhost:5432/iugm_scolarite_test_db?schema=public"
AUTH_SECRET="test-secret-not-for-production-0000000000000000000000000000000000"
