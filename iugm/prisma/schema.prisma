generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Rôles officiels basés sur le diagramme de cas d'utilisation
enum Role {
  SUPERADMIN
  AGENT_ADMINISTRATION
  AGENT_PEDAGOGIQUE
  ETUDIANT
}

// Table centrale pour la gestion de l'authentification et des profils
model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  passwordHash            String
  // Force le changement de mot de passe à la prochaine connexion
  // (vrai pour les comptes étudiants créés avec le matricule comme mot de passe)
  mustChangePassword      Boolean                 @default(false)
  // Compte désactivé : connexion refusée (géré depuis la page Permissions)
  active                  Boolean                 @default(true)
  // Fonction / poste (ex : Secrétaire, Chef de scolarité, Responsable finance...)
  jobTitle                String?
  // Photo de profil (data URL, gérée par l'utilisateur sur sa page Mon compte)
  photo                   String?
  // Tâches autorisées pour cet utilisateur (clés du catalogue lib/permissions.ts).
  // Deux agents du même rôle peuvent avoir des permissions différentes.
  permissions             String[]                @default([])
  // Formation affectée (ex : "Management") : l'agent ne voit et ne manipule
  // que les dossiers de cette formation. Null = toutes les formations.
  formation               String?
  role                    Role                    @default(ETUDIANT)
  fullName                String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  auditLogs               AuditLog[]
  // Dossier étudiant lié si ce compte a été créé via la validation pédagogique
  studentFile             Student?
  // Communiqués rédigés (agents) et marques de lecture (étudiants)
  announcements           Announcement[]          @relation("AuthoredAnnouncements")
  announcementReads       AnnouncementRead[]
  ecolagePaymentsVerified EcolagePayment[]
  preselectionImports     PreselectionCandidate[]
}

// Workflow d'inscription d'un étudiant
enum StudentStatus {
  ENREGISTRE // dossier créé par l'agent d'administration
  PAIEMENT_VERIFIE // reçu bancaire vérifié
  ADMIN_VALIDEE // inscription administrative validée
  INSCRIT // inscription pédagogique validée, compte étudiant créé
}

// Dossier étudiant géré par les agents (distinct du compte de connexion User)
model Student {
  id           String  @id @default(cuid())
  matricule    String  @unique // format FI2026-1 (FI + année d'inscription + n° séquentiel)
  academicYear String? // année universitaire de rattachement, ex "2026-2027"

  // Identité
  fullName      String // "NOM Prénom" (affichage et compatibilité)
  lastName      String?
  firstName     String?
  gender        String? // "M" | "F"
  birthDate     DateTime?
  birthPlace    String?
  motherName    String?
  fatherName    String?
  nationality   String? // "Malagasy" | "Étranger"
  maritalStatus String? // situation familiale : Célibataire | Marié(e) | Salarié(e)

  // Carte d'identité nationale
  cin           String?
  cinIssueDate  DateTime?
  cinIssuePlace String?

  // Renseignements sur le baccalauréat
  baccNumber         String? // numéro du bacc
  baccYear           String? // année d'obtention
  baccSeries         String? // série
  baccMention        String? // mention obtenue au bacc
  baccCenter         String? // centre d'examen
  baccCountry        String? // pays
  previousSchool     String? // établissement d'origine
  previousUniversity String? // inscription antérieure à l'université
  repeatCode         String? // hérité : N = nouveau, R = redoublant, T = triplant

  // Contact
  address       String? // adresse exacte de l'étudiant
  phone         String?
  personalEmail String?

  // Parents
  parentsPhone   String?
  parentsAddress String?
  parentsCity    String?

  // Personne à contacter d'urgence (obligatoire pour chaque étudiant)
  guardianName    String?
  guardianPhone   String?
  guardianAddress String?

  // Pièces du dossier (cochées par l'agent à la réception)
  docResidenceCert    Boolean @default(false) // certificat de résidence
  docCinCopy          Boolean @default(false) // copie légalisée CIN / acte d'état civil (mineur)
  docParentCin        Boolean @default(false) // CIN légalisée du parent
  docPhotos           Boolean @default(false) // 4 photos d'identité récentes
  docPinkFolder       Boolean @default(false) // papier chemise rose
  docPaymentSlip      Boolean @default(false) // bordereau de versement
  docEngagementLetter Boolean @default(false) // lettre d'engagement co-signée
  // Pièces de réinscription (cochées par l'agent à chaque réinscription, puis
  // remises à false : à revérifier l'année suivante — voir reenrollStudent)
  docTranscript       Boolean @default(false) // copie certifiée du relevé de notes
  docBlueFolder       Boolean @default(false) // papier chemise bleu

  // Cursus
  domain       String? // domaine
  mention      String? // mention du cursus
  track        String? // parcours
  trainingType String? // type de formation
  program      String? // hérité : filière (alimenté avec la mention)
  level        String? // hérité : niveau
  department   String? // hérité : département (alimenté avec le domaine)

  receiptNumber     String? // numéro du reçu bancaire vérifié
  conduct           String? // appréciation de conduite (rédigée par l'agent pédagogique)
  status            StudentStatus          @default(ENREGISTRE)
  // Horodatages dédiés (au lieu de retrouver la date dans le journal d'audit,
  // qui n'est pas lié au dossier et survit à sa suppression) : le graphique du
  // tableau de bord doit refléter seulement les dossiers qui existent encore.
  receiptVerifiedAt DateTime?
  pedagoValidatedAt DateTime?
  // Compte de connexion créé automatiquement à la validation pédagogique
  account           User?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId         String?                @unique
  // Mot de passe initial du compte, imprimé sur le reçu d'inscription pour être
  // remis à l'étudiant (à changer par l'étudiant à sa première connexion)
  initialPassword   String?
  // Jeton opaque (aléatoire, non devinable) encodé dans le QR code de la carte
  // étudiante numérique — jamais le matricule ni l'id, tous deux trop
  // prévisibles pour servir de clé à une page publique sans connexion.
  // Régénérable par l'étudiant si le code a été partagé par erreur.
  qrToken           String?                @unique
  // Années universitaires précédentes (archivées à chaque réinscription)
  enrollmentHistory EnrollmentHistory[]
  results           AcademicResult[]
  ecolagePayments   EcolagePayment[]
  // Fiche de présélection (Université de Mahajanga) à partir de laquelle ce
  // dossier a été créé, le cas échéant — voir PreselectionCandidate.
  fromPreselection  PreselectionCandidate?
  // Communiqués personnels adressés à ce dossier (ex : avis d'admission
  // automatique) — distincts des communiqués groupés par filière/niveau,
  // voir Announcement.studentId
  announcements     Announcement[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  // + index trigram (pg_trgm/GIN) sur fullName, matricule, receiptNumber,
  // program, department, cin, track pour les recherches "contains" — voir la
  // migration 20260721153910_student_search_trgm_index (SQL brut : la syntaxe
  // Prisma ne modélise pas l'opclass gin_trgm_ops).

  @@index([fullName])
  @@index([status])
  @@index([academicYear])
}

// Année universitaire passée d'un étudiant, archivée lors de sa réinscription
model EnrollmentHistory {
  id                String    @id @default(cuid())
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         String
  academicYear      String
  track             String? // parcours / classe suivie cette année-là
  status            String // statut au moment de l'archivage (normalement INSCRIT)
  receiptNumber     String?
  // Horodatages de l'année archivée, copiés depuis Student avant leur remise à
  // zéro par reenrollStudent — sans cette copie, le graphique du tableau de
  // bord (getInscriptionTrend) perdrait ces événements passés dès qu'un
  // étudiant se réinscrit, alors qu'ils ont bien eu lieu.
  receiptVerifiedAt DateTime?
  pedagoValidatedAt DateTime?
  // Pièces de réinscription vérifiées pour cette année, copiées depuis
  // Student avant leur remise à zéro par reenrollStudent (même logique que
  // receiptVerifiedAt/pedagoValidatedAt ci-dessus)
  docTranscript     Boolean   @default(false)
  docBlueFolder     Boolean   @default(false)
  archivedAt        DateTime  @default(now())

  @@index([studentId])
}

// Deux origines possibles pour une fiche importée dans "Base de données" —
// distinguer les deux évite qu'un ré-import de l'une n'efface l'autre (le
// remplacement d'un lot est scopé par [academicYear, category], voir
// importPreselectionFile dans lib/preselection.ts).
enum PreselectionCategory {
  PRESELECTION // nouveaux candidats L1 présélectionnés par l'Université de Mahajanga
  EXISTING // dossiers d'étudiants déjà à l'université (tout niveau), pas encore saisis dans ce portail
}

// Fiche importée en lot par le superadmin depuis un fichier Excel déjà en
// circulation à l'université (résultats de présélection de Mahajanga pour
// les nouveaux L1, ou dossiers papier/Excel des étudiants déjà sur place à
// un autre niveau) — voir PreselectionCategory. Sert uniquement à
// pré-remplir le formulaire d'inscription (recherche par nom) pour que
// l'agent d'administration n'ait plus qu'à vérifier les pièces et valider :
// une entrée n'est jamais promue automatiquement en Student, la saisie
// manuelle habituelle (registerStudent) reste le seul chemin de création.
model PreselectionCandidate {
  id String @id @default(cuid())

  category PreselectionCategory @default(PRESELECTION)

  // Lot d'import : année universitaire d'inscription visée (ex "2026-2027").
  // Un ré-import pour la même année ET catégorie remplace le lot précédent
  // (voir importPreselectionFile dans lib/preselection.ts) pour éviter
  // d'accumuler des doublons à chaque nouvelle version du fichier reçu.
  academicYear String

  // Identité (mêmes champs que le formulaire d'inscription, pour un pré-remplissage direct)
  lastName    String
  firstName   String
  fullName    String // "NOM Prénom", utilisé pour la recherche par nom
  gender      String? // "M" | "F"
  birthDate   DateTime?
  birthPlace  String?
  nationality String?

  cin           String?
  cinIssueDate  DateTime?
  cinIssuePlace String?

  phone         String?
  personalEmail String?
  address       String?

  baccNumber  String?
  baccSeries  String?
  baccMention String?
  baccYear    String?
  baccCenter  String?
  baccCountry String?

  previousSchool String?

  fatherName     String?
  motherName     String?
  parentsPhone   String?
  parentsAddress String?
  parentsCity    String?

  // Filière affectée par la présélection (correspond à FORMATIONS / Student.mention)
  formation String?
  level     String? // niveau d'entrée visé, ex "L1"

  // Dossier d'inscription créé à partir de cette ligne, une fois que l'agent
  // l'a choisie dans la recherche et validée — la fiche reste visible dans la
  // recherche mais affichée comme "déjà inscrit" plutôt que supprimée, pour
  // garder une trace de correspondance avec le fichier de Mahajanga.
  usedByStudent   Student?  @relation(fields: [usedByStudentId], references: [id], onDelete: SetNull)
  usedByStudentId String?   @unique
  usedAt          DateTime?

  importedBy   User?    @relation(fields: [importedById], references: [id], onDelete: SetNull)
  importedById String?
  importedAt   DateTime @default(now())

  @@index([academicYear, category])
  @@index([fullName])
}

// Mention calculée automatiquement à partir de la moyenne (/20)
enum Mention {
  ECHEC // < 10
  PASSABLE // 10 à < 12
  ASSEZ_BIEN // 12 à < 14
  BIEN // 14 à < 16
  TRES_BIEN // >= 16
}

// Résultat académique assigné par l'agent pédagogique
model AcademicResult {
  id           String   @id @default(cuid())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  academicYear String // ex: "2025-2026"
  semester     String // "S1", "S2"...
  average      Float // moyenne sur 20
  mention      Mention
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, academicYear, semester])
  @@index([mention])
}

// Origine d'un communiqué : rédigé manuellement par un agent, ou généré
// automatiquement (ex : avis d'admission à l'issue des résultats S1+S2, ou
// message de bienvenue à la création du compte — voir validatePedagoInscription).
enum AnnouncementKind {
  MANUAL
  ADMISSION_NOTICE
  WELCOME
}

// Communiqué envoyé par un agent aux étudiants (lecture seule côté étudiant).
// Ciblage par groupe (filière et/ou niveau ; null = tous) OU, si `studentId`
// est renseigné, communiqué personnel visible uniquement par ce dossier
// (voir targetingWhere dans lib/announcements.ts) — les deux modes de
// ciblage sont mutuellement exclusifs pour une même ligne.
model Announcement {
  id                 String             @id @default(cuid())
  title              String
  body               String
  formation          String? // filière ciblée (null = toutes) — ignoré si studentId renseigné
  level              String? // niveau ciblé (null = tous) — ignoré si studentId renseigné
  student            Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId          String? // communiqué personnel : destinataire unique
  kind               AnnouncementKind   @default(MANUAL)
  // Année universitaire à l'origine d'un avis d'admission automatique — sert
  // uniquement à dédoublonner (voir @@unique ci-dessous et
  // maybeSendAdmissionAnnouncement dans lib/students.ts) : un ré-enregistrement
  // du S2 d'une même année ne doit pas renvoyer un second avis.
  sourceAcademicYear String?
  author             User?              @relation("AuthoredAnnouncements", fields: [authorId], references: [id], onDelete: SetNull)
  authorId           String?
  reads              AnnouncementRead[]
  createdAt          DateTime           @default(now())

  @@unique([studentId, sourceAcademicYear, kind])
  @@index([createdAt])
  @@index([studentId])
}

// Marque de lecture d'un communiqué par un étudiant (badge « non lu »)
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// Paramètres de l'établissement (clé/valeur) : nom, adresse, logo (data URL), etc.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Renseignements financiers par niveau (droit d'inscription, assurance,
// polo, frais de formation, premier versement), configurables par le
// superadmin depuis Paramètres — base du calcul du paiement à l'inscription
// et du solde d'écolage restant dû (voir lib/finance.ts et
// verifyRegistrationPayment/recordEcolagePayment dans lib/students.ts).
model LevelFinancialInfo {
  id                  String   @id @default(cuid())
  level               String   @unique // L1, L2, L3, M1, M2
  inscriptionLocal    Int // droit d'inscription, étudiant local
  inscriptionForeign  Int // droit d'inscription, étudiant étranger
  insurance           Int // assurance
  polo                Int // polo (optionnel pour un ancien étudiant)
  tuitionLocal        Int // frais de formation annuel, étudiant local
  tuitionForeign      Int // frais de formation annuel, étudiant étranger
  firstPaymentLocal   Int // premier versement, étudiant local
  firstPaymentForeign Int // premier versement, étudiant étranger
  updatedAt           DateTime @updatedAt
}

// Type de versement d'écolage pour une année universitaire donnée : soit
// deux tranches semestrielles (moitié du tarif annuel chacune), soit la
// totalité en un seul versement. Les deux modes sont mutuellement exclusifs
// pour une même année (voir recordEcolagePayment).
enum EcolagePaymentType {
  TRANCHE_S1
  TRANCHE_S2
  TOTALITE
}

// Versement d'écolage effectué par un étudiant pour une année universitaire.
// Indépendant de Student.receiptNumber/receiptVerifiedAt (qui ne retiennent
// que le tout premier versement, pour débloquer la suite du dossier) : ici,
// chaque versement de chaque année reste une ligne d'historique à part,
// jamais réinitialisée par une réinscription.
model EcolagePayment {
  id            String             @id @default(cuid())
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  academicYear  String
  type          EcolagePaymentType
  amount        Int // montant calculé depuis le tarif de la filière, en ariary
  receiptNumber String
  verifiedBy    User?              @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById  String?
  verifiedAt    DateTime           @default(now())

  // Un seul versement par type et par année (pas de double 1ère tranche, etc.)
  @@unique([studentId, academicYear, type])
  @@index([studentId])
  @@index([academicYear])
}

// Journal des actions sensibles (connexions, créations de comptes, etc.)
model AuditLog {
  id        String   @id @default(cuid())
  action    String // ex: LOGIN_SUCCESS, LOGIN_FAILED, USER_CREATED
  details   String? // contexte lisible (email ciblé, rôle attribué, etc.)
  // L'acteur est optionnel : un LOGIN_FAILED n'a pas d'utilisateur identifié
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Tentatives de connexion (succès et échecs), utilisées uniquement pour le
// blocage anti-bruteforce. Distinct de AuditLog (texte libre, lecture humaine) :
// ici les colonnes sont indexées pour compter rapidement les échecs récents
// par email et par IP.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
